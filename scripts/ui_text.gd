static func t(key: String, values: Array = []) -> String:
    if not VI.has(key):
        push_error("Missing UI translation: " + key)
        return "Thiếu bản dịch"
    var result: String = VI[key]
    return result if values.is_empty() else result % values

static func system_name(system: String) -> String:
    var index := GameData.SYSTEMS.find(system)
    return GameData.SYSTEM_NAMES[index] if index >= 0 else t("common.none")

static func category_name(category: String) -> String:
    return t("category.pet" if category == "pet" else "category.employee")
